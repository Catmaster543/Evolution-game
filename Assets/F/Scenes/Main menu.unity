  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 67484127}
  lines:
  - Welcome Welcome! I'm glad you came to try my game!
  - Why did it stop loading?
  - Oh no...
  - NOT THE CORRUPTED FILES
  - 'wait- '
  - they keep leaking into the unaffected ones...
  - How will I finish my game on time??
  - Oh wait! You can keep them at bay for me, while I rework the game!
  - '-'
  isTyping: 0
  splaScreen: {fileID: 749978690}
  menu: {fileID: 994990098}
