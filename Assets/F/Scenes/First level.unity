  m_Script: {fileID: 11500000, guid: d5de914b3d7ea7144931381d590f5152, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutDialogue
  i: 0
  textComponent: {fileID: 2032123887}
  lines:
  - Hi again, looks like you made it through the update succesfully
  - I just added the shop back!
  - .. you haven't  seen it before, have you?
  - Well to put it simply - you can purchase new trees in the shop
  - Just as I've said before - you can buy a new tree by placing in an empty spot,
    or upgrade an existing one by clicking on that tree instead.
  - Go ahead and buy one now-
  - There you go, good job!
  - As I update and fix the game more powerful trees shall come, but the same may
    be with the enemies..
  - But you'll manage, I believe in you
  - I think this is all you'll need to know, good luck!
  isTyping: 0
  buying: 0
