  m_Script: {fileID: 11500000, guid: c576bf24a0fda024e947e5b6ec573873, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutDialogue
  i: 0
  textComponent: {fileID: 1292753887}
  lines:
  - 'It was supposed to be about nature versus pollution.... '
  - ... well let's get to work!
  - You can keep the corruption at bay by planting trees.
  - Here - try planting this one!
  - (Click on the yellow square to place the tree there)
  - After a tree is planted, it cannot be removed..
  - Soo.. you better have chosen well!
  - Another tree of the same variant CAN be placed on it tho-
  - Which will upgrade the tree.
  - Now I've got to go before the corrupted files eat up the game whole-
  - I will evolve and fix the game as you play.
  - 
  isTyping: 0
  placing: 0
