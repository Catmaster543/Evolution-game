  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndDialog
  i: 0
  textComponent: {fileID: 1197834226}
  lines:
  - You've done it!
  - You're awesome, player!
  - The files have now been patched, thanks to your help
  - So I can keep on living here safely, thanks!
  - How can I even pay you back for this..
  - Did you happen to enjoy the game?
  - You did?
  - Well how about I let you enjoy it for as long as you want? (maybe in another
    actual update)
  - Deal!
  - '-'
  isTyping: 0
  endChoices: {fileID: 137517656}
  endFadeScreen: {fileID: 566807889}
  placing: 0
